MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ecomm?retryWrites=true&w=majority
RESEND_API_KEY=re_your_resend_api_key
# Gets an email for every new order (defaults to info@dhaanyafoods.com)
OWNER_ORDER_ALERT_EMAIL=info@dhaanyafoods.com
# Cashfree: online payment appears at checkout only when both keys are set.
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# sandbox (test payments) or production (real money)
CASHFREE_ENV=sandbox
# Public address, used for the return and webhook URLs
SITE_URL=https://dhaanyafoods.com
# SMTP_USER / SMTP_PASS are no longer used (email now sends via Resend above) -- left undocumented on purpose
